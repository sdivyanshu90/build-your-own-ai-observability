{
  "name": "@aiobs/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the AI Observability Platform",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/integrations/express.d.ts",
      "default": "./dist/integrations/express.js"
    },
    "./openai": {
      "types": "./dist/integrations/openai.d.ts",
      "default": "./dist/integrations/openai.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aiobs/schemas": "0.1.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@types/node": "22.13.5"
  }
}
