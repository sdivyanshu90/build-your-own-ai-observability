# AI Observability Platform -- environment configuration
#
# Copy to .env and adjust. Every variable is optional: the defaults below are
# what `make dev` uses, and they are chosen to work on a laptop with no external
# services.
#
# Nested settings use a double underscore: AIOBS_DATABASE__URL maps to
# settings.database.url. The full reference is in docs/operations/configuration.md.
#
# ---------------------------------------------------------------------------
# NEVER commit a real .env. Secrets belong in your platform's secret manager;
# see docs/security/secrets.md for the interfaces this platform supports.
# ---------------------------------------------------------------------------

# --- application -----------------------------------------------------------
AIOBS_ENVIRONMENT=development
AIOBS_LOG_LEVEL=INFO
# 'console' is readable in a terminal; production must use 'json'.
AIOBS_LOG_FORMAT=console
AIOBS_PUBLIC_URL=http://localhost:58000
AIOBS_WEB_URL=http://localhost:53000

# --- metadata store --------------------------------------------------------
# Development default is a local SQLite file. Production MUST be PostgreSQL:
# the platform refuses to start otherwise.
AIOBS_DATABASE__URL=sqlite+aiosqlite:///./.aiobs/metadata.db
# AIOBS_DATABASE__URL=postgresql+asyncpg://aiobs:aiobs@localhost:55432/aiobs
AIOBS_DATABASE__POOL_SIZE=10
AIOBS_DATABASE__MAX_OVERFLOW=20

# --- analytics store -------------------------------------------------------
# 'sqlite' for local work and CI; 'clickhouse' everywhere else.
AIOBS_ANALYTICS__DRIVER=sqlite
AIOBS_ANALYTICS__SQLITE_PATH=./.aiobs/analytics.db
AIOBS_ANALYTICS__URL=http://localhost:58123
AIOBS_ANALYTICS__DATABASE=aiobs
AIOBS_ANALYTICS__USERNAME=aiobs
AIOBS_ANALYTICS__PASSWORD=aiobs
AIOBS_ANALYTICS__INSERT_BATCH_SIZE=5000

# --- object storage --------------------------------------------------------
# 'filesystem' is node-local and unsuitable for production.
AIOBS_OBJECTS__DRIVER=filesystem
AIOBS_OBJECTS__ROOT_PATH=./.aiobs/objects
AIOBS_OBJECTS__BUCKET=aiobs-payloads
# AIOBS_OBJECTS__DRIVER=s3
# AIOBS_OBJECTS__ENDPOINT_URL=http://localhost:59001
# AIOBS_OBJECTS__ACCESS_KEY_ID=aiobsminio
# AIOBS_OBJECTS__SECRET_ACCESS_KEY=aiobsminio-secret

# --- key/value (rate limits, de-duplication, locks) ------------------------
# 'memory' cannot coordinate across replicas; production must use redis.
AIOBS_KV__DRIVER=memory
AIOBS_KV__URL=redis://localhost:56379/0
AIOBS_KV__DEDUP_TTL_SECONDS=3600

# --- event bus -------------------------------------------------------------
# 'database' is a durable single-node queue; 'kafka' for Kafka or Redpanda.
AIOBS_BUS__DRIVER=database
AIOBS_BUS__BROKERS=localhost:59092
AIOBS_BUS__TOPIC_PREFIX=aiobs
AIOBS_BUS__CONSUMER_GROUP=aiobs-worker
AIOBS_BUS__MAX_DELIVERY_ATTEMPTS=5

# --- authentication --------------------------------------------------------
# MUST be replaced outside development. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AIOBS_AUTH__JWT_SECRET=dev-only-insecure-secret-change-me
AIOBS_AUTH__ACCESS_TOKEN_TTL_SECONDS=3600
AIOBS_AUTH__ENABLE_LOCAL_AUTH=true
# AIOBS_AUTH__OIDC_ISSUER=https://id.example.com
# AIOBS_AUTH__OIDC_CLIENT_ID=aiobs
# AIOBS_AUTH__OIDC_CLIENT_SECRET=

# --- security --------------------------------------------------------------
# Both spellings of loopback are listed because a browser treats them as
# different origins. In any deployment, replace this with your real origin --
# startup validation refuses a non-development configuration that allows a
# plaintext http:// origin with credentials.
AIOBS_SECURITY__CORS_ALLOW_ORIGINS=["http://localhost:53000","http://127.0.0.1:53000"]
AIOBS_SECURITY__COOKIE_SECURE=false
AIOBS_SECURITY__MAX_REQUEST_BYTES=8388608
AIOBS_SECURITY__INGEST_RATE_LIMIT_PER_MINUTE=6000
AIOBS_SECURITY__API_RATE_LIMIT_PER_MINUTE=600
# Number of trusted proxies in front of the API. 0 means X-Forwarded-For is
# ignored entirely, which is correct when nothing is in front.
AIOBS_SECURITY__TRUSTED_PROXY_HOPS=0

# --- ingestion -------------------------------------------------------------
AIOBS_INGEST__STORE_PAYLOADS=true
AIOBS_INGEST__REDACT_BY_DEFAULT=true
AIOBS_INGEST__MAX_CLOCK_SKEW_FUTURE_SECONDS=300
AIOBS_INGEST__MAX_BACKFILL_AGE_SECONDS=604800

# --- retention -------------------------------------------------------------
AIOBS_RETENTION__RAW_SPAN_DAYS=30
AIOBS_RETENTION__AGGREGATE_DAYS=395
AIOBS_RETENTION__PAYLOAD_DAYS=14

# --- platform self-observability -------------------------------------------
AIOBS_TELEMETRY__ENABLE_METRICS=true
AIOBS_TELEMETRY__ENABLE_TRACING=false
# Point at a SEPARATE collector, never at this platform's own ingest endpoint.
# AIOBS_TELEMETRY__OTLP_ENDPOINT=http://localhost:54318

# ===========================================================================
# SDK configuration (for demos and instrumented applications)
# ===========================================================================
AIOBS_ENDPOINT=http://localhost:58000
# Printed once by `make bootstrap`. Not recoverable afterwards.
AIOBS_API_KEY=
AIOBS_SERVICE_NAME=my-ai-application
AIOBS_SAMPLE_RATE=1.0
AIOBS_CAPTURE_PAYLOADS=true

# ===========================================================================
# Frontend
# ===========================================================================
NEXT_PUBLIC_API_URL=http://localhost:58000
